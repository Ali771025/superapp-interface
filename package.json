{
  "name": "superapp-interface",
  "private": true,
  "version": "2.10.20-rc.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:special3": "node scripts/dev-special3.mjs",
    "generate:special3-tokens": "node scripts/generate-special3-tokens.mjs",
    "build": "node scripts/clean-dist.mjs && vite build && node tests/bundle-report.mjs",
