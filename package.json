    "playwright-core": "^1.61.1",
    "postcss": "^8.4.35",
    "rollup": "4.62.4",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2"
  }
